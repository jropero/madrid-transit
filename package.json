{
  "name": "madrid-transit",
  "version": "0.0.1",
  "private": true,
  "description": "Next Renfe Cercanías departures in Madrid",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "data": "node scripts/timetable.mjs",
    "build": "node scripts/timetable.mjs && tsc && vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint:css": "stylelint src/index.css",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "husky": "^9.1.7",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "lint-staged": {
    "*.css": "stylelint"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  }
}
